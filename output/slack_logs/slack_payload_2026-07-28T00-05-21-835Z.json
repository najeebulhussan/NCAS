      {
        "type": "header",
        "text": {
          "type": "plain_text",
          "text": "🎬 NCAS Broadcast Approval Gate",
          "emoji": true
        }
      },
      {
        "type": "section",
        "fields": [
          {
            "type": "mrkdwn",
            "text": "*Job ID:*\nJOB-2026-001"
          },
          {
            "type": "mrkdwn",
            "text": "*Channel Handle:*\n@NajeebCyber"
          },
          {
            "type": "mrkdwn",
            "text": "*Topic:*\nGlobal Cyber Attack Surge"
          },
          {
            "type": "mrkdwn",
            "text": "*CVSS Severity:*\n9.8 (Critical)"
          }
        ]
      },
      {
        "type": "section",
        "text": {
          "type": "mrkdwn",
          "text": "*Status:* `PAUSED_FOR_HUMAN_REVIEW` — Verification required before script rendering."
        }
      },
      {
        "type": "actions",
        "elements": [
          {
            "type": "button",
            "text": {
              "type": "plain_text",
              "text": "✅ Approve Strategy & Script",
              "emoji": true
            },
            "style": "primary",
            "value": "approve_JOB-2026-001"
          },
          {
            "type": "button",
            "text": {
              "type": "plain_text",
              "text": "✏️ Request Changes",
              "emoji": true
            },
            "value": "edit_JOB-2026-001"
          },
          {
            "type": "button",
            "text": {
              "type": "plain_text",
              "text": "⛔ Reject / Pause",
              "emoji": true
            },
            "style": "danger",
            "value": "reject_JOB-2026-001"
          }
        ]
      }
    ]
  },
  "sampleCmdResponse": {
    "response_type": "in_channel",
    "text": "🤖 *NCAS Swarm Status:* 22/22 Agents Active • API Gateway: `http://localhost:8000` • Web Studio: `http://localhost:786`"
